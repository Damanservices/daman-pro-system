{
    "hosting": {
        "source": "Frontend",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ],
        "frameworksBackend": {
            "region": "us-central1"
        }
    },
    "database": {
        "rules": "database.rules.json"
    },
    "emulators": {
        "database": {
            "port": 9000
        },
        "hosting": {
            "port": 5000
        },
        "ui": {
            "enabled": true,
            "port": 4000
        }
    }
}